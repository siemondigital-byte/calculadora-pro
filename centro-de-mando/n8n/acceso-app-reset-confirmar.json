{
  "name": "Acceso app - recuperar password (confirmar) - Calculadora",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "password-reset-confirm",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "name": "Webhook confirmar",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "webhookId": "password-reset-confirm"
    },
    {
      "parameters": {
        "jsCode": "// Sanitiza el token (solo hex) y valida la password minima; si algo\n// falla, el token queda vacio y el consumo no matchea -> 403 generico.\nconst b = $input.first().json.body || {};\nlet token = String(b.token || '').replace(/[^a-f0-9]/gi, '');\nconst password = String(b.password || '');\nif (password.length < 8) token = '';\nreturn [{ json: { token, ahora: new Date().toISOString() } }];"
      },
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/password_resets?token=eq.{{ $json.token || 'sin-token' }}&usado=eq.false&expira_en=gt.{{ $json.ahora }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ usado: true }) }}",
        "options": {}
      },
      "name": "Supabase: consumir token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        620,
        300
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.email || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Token valido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\"ok\": false, \"error\": \"enlace no válido o vencido\"} }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          },
          "responseCode": 403
        }
      },
      "name": "Respond 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        840,
        500
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/auth/v1/admin/users?per_page=1000",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Supabase: buscar usuario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1060,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const email = ($('¿Token valido?').first().json.email || '').toLowerCase();\nconst users = ($input.first().json.users) || [];\nconst u = users.find(x => (x.email || '').toLowerCase() === email);\nreturn [{ json: { id: u ? u.id : '' } }];"
      },
      "name": "Extraer id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Usuario existe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1500,
        220
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.SUPABASE_URL }}/auth/v1/admin/users/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ password: $('Webhook confirmar').item.json.body.password }) }}",
        "options": {}
      },
      "name": "Supabase: cambiar password",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1720,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const T = {\"es\": \"<!doctype html>\\n<html lang=\\\"es\\\" xmlns=\\\"http://www.w3.org/1999/xhtml\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\" />\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n<meta name=\\\"x-apple-disable-message-reformatting\\\" />\\n<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\" />\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\" />\\n<title>Restablece tu contraseña · Atlantis Global Realty</title>\\n<!--\\n  ============================================================================\\n  THE MONEY COMMAND · Correo de cambio de contraseña — versión para n8n (ES)\\n  ----------------------------------------------------------------------------\\n  Compatible con clientes de correo (tablas + estilos inline). Modo oscuro\\n  automático vía prefers-color-scheme.\\n\\n  VARIABLES a rellenar en el nodo de n8n (Set / Edit Fields o el propio Send Email):\\n    {{NOMBRE}}      -> nombre del usuario\\n    https://app.atlantisglobalrealty.com     -> URL de la app (boton)\\n    Calculadora de Viabilidad Inmobiliaria Pro    -> nombre visible del producto\\n    #C6A87F      -> color de acento (hex)\\n    mailto:hola@atlantisglobalrealty.com -> enlace de soporte\\n  Elige el archivo -ES o -EN según el idioma del usuario en tu workflow.\\n  ============================================================================\\n-->\\n<style>\\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\\n  body,table,td,a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\\n  table,td { mso-table-lspace:0pt; mso-table-rspace:0pt; }\\n  img { border:0; line-height:100%; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }\\n  a { text-decoration:none; }\\n  @media (prefers-color-scheme: dark) {\\n    .bg      { background:#0a0a0f !important; }\\n    .card    { background:#14141d !important; border-color:#262630 !important; }\\n    .divider { border-color:#262630 !important; }\\n    .soft    { background:#1c1c27 !important; border-color:#262630 !important; }\\n    .t-strong{ color:#f0f0f8 !important; }\\n    .t-body  { color:#b9b9c8 !important; }\\n    .t-mut   { color:#8a8a9e !important; }\\n    .t-faint { color:#6a6a7c !important; }\\n    .pre     { background:#1c1c27 !important; color:#6a6a7c !important; }\\n  }\\n  @media (max-width:600px){\\n    .px { padding-left:22px !important; padding-right:22px !important; }\\n    .container { width:100% !important; }\\n  }\\n</style>\\n</head>\\n<body class=\\\"bg\\\" style=\\\"margin:0;padding:0;background:#eef0f3;\\\">\\n  <div style=\\\"display:none;max-height:0;overflow:hidden;opacity:0;\\\">Crea una nueva contraseña para tu cuenta. El enlace vence en 60 minutos.</div>\\n  <table role=\\\"presentation\\\" class=\\\"bg\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#eef0f3;\\\">\\n    <tr><td align=\\\"center\\\" style=\\\"padding:30px 14px 60px;\\\">\\n      <table role=\\\"presentation\\\" class=\\\"container\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:600px;max-width:600px;\\\">\\n\\n        <!-- card -->\\n        <tr><td class=\\\"card\\\" style=\\\"background:#ffffff;border:1px solid #e4e6ea;border-radius:16px;\\\">\\n\\n          <!-- header -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\">\\n            <tr><td class=\\\"divider px\\\" style=\\\"padding:24px 34px 20px;border-bottom:1px solid #e4e6ea;\\\">\\n              <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n                <td width=\\\"12\\\" valign=\\\"middle\\\" style=\\\"width:12px;padding:0;\\\"><div style=\\\"width:11px;height:11px;min-width:11px;border-radius:50%;background:#C6A87F;font-size:0;line-height:0;\\\">&nbsp;</div></td>\\n                <td valign=\\\"middle\\\" class=\\\"t-strong\\\" style=\\\"padding-left:11px;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:17px;letter-spacing:-.3px;color:#15151f;white-space:nowrap;\\\">Atlantis <span style=\\\"color:#C6A87F;\\\">Global Realty</span></td>\\n              </tr></table>\\n            </td></tr>\\n          </table>\\n\\n          <!-- body -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:30px 34px 6px;\\\">\\n            <p style=\\\"margin:0 0 12px;font-family:'DM Mono',Menlo,monospace;font-size:10px;letter-spacing:2.2px;text-transform:uppercase;color:#C6A87F;\\\">Seguridad de la cuenta</p>\\n            <h1 class=\\\"t-strong\\\" style=\\\"margin:0 0 14px;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:29px;line-height:1.14;letter-spacing:-.5px;color:#15151f;\\\">Tu contraseña <span style=\\\"color:#C6A87F;\\\">fue actualizada.</span></h1>\\n            <p class=\\\"t-body\\\" style=\\\"margin:0 0 4px;font-family:'DM Mono',Menlo,monospace;font-size:14px;line-height:1.65;color:#55556a;\\\">Hola {{NOMBRE}}, te confirmamos que la contraseña de tu cuenta se cambió correctamente. Ya puedes entrar con la nueva.</p>\\n          </td></tr></table>\\n\\n          <!-- CTA -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" align=\\\"left\\\" style=\\\"padding:24px 34px 4px;\\\">\\n            <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n              <td style=\\\"border-radius:13px;background:#C6A87F;\\\">\\n                <a href=\\\"https://app.atlantisglobalrealty.com\\\" target=\\\"_blank\\\" style=\\\"display:inline-block;padding:16px 30px;font-family:'Inter',Arial,sans-serif;font-weight:700;font-size:15px;letter-spacing:-.2px;color:#ffffff;border-radius:13px;\\\">Ir a la app &rarr;</a>\\n              </td>\\n            </tr></table>\\n          </td></tr></table>\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:12px 34px 0;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:11px;letter-spacing:.4px;color:#8a8a99;\\\">◷ Este cambio se aplicó justo ahora.</p>\\n          </td></tr></table>\\n\\n          <!-- security -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <p class=\\\"t-mut\\\" style=\\\"margin:0;font-size:12px;line-height:1.55;color:#5d5d6c;\\\"><b style=\\\"color:inherit;\\\">¿No fuiste tú?</b> Escríbenos de inmediato: alguien más podría tener acceso a tu cuenta.<b style=\\\"display:none\\\"></p>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- signature -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 6px;\\\">\\n            <p class=\\\"t-mut\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:12.5px;color:#5d5d6c;\\\">Cualquier duda, responde a este correo. Nos vemos dentro.<br><b style=\\\"font-family:'Inter',Arial,sans-serif;\\\">El equipo de Atlantis Global Realty</b></p>\\n          </td></tr></table>\\n\\n          <!-- footer -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"divider px\\\" style=\\\"padding:20px 34px 28px;border-top:1px solid #e4e6ea;margin-top:16px;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:16px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;line-height:1.6;color:#8a8a99;\\\">Recibes este correo porque la contraseña de tu cuenta cambió.</p>\\n            <p class=\\\"t-faint\\\" style=\\\"margin:8px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;color:#8a8a99;\\\">© 2026 Atlantis Global Realty · <a href=\\\"mailto:hola@atlantisglobalrealty.com\\\" class=\\\"t-mut\\\" style=\\\"color:#5d5d6c;\\\">Soporte</a></p>\\n          </td></tr></table>\\n\\n        </td></tr>\\n      </table>\\n    </td></tr>\\n  </table>\\n</body>\\n</html>\", \"en\": \"<!doctype html>\\n<html lang=\\\"en\\\" xmlns=\\\"http://www.w3.org/1999/xhtml\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\" />\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n<meta name=\\\"x-apple-disable-message-reformatting\\\" />\\n<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\" />\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\" />\\n<title>Reset your password · Atlantis Global Realty</title>\\n<!--\\n  ============================================================================\\n  THE MONEY COMMAND · Correo de cambio de contraseña — versión para n8n (EN)\\n  ----------------------------------------------------------------------------\\n  Compatible con clientes de correo (tablas + estilos inline). Modo oscuro\\n  automático vía prefers-color-scheme.\\n\\n  VARIABLES a rellenar en el nodo de n8n (Set / Edit Fields o el propio Send Email):\\n    {{NOMBRE}}      -> nombre del usuario\\n    https://app.atlantisglobalrealty.com     -> URL de la app (boton)\\n    Calculadora de Viabilidad Inmobiliaria Pro    -> nombre visible del producto\\n    #C6A87F      -> color de acento (hex)\\n    mailto:hola@atlantisglobalrealty.com -> enlace de soporte\\n  Elige el archivo -ES o -EN según el idioma del usuario en tu workflow.\\n  ===================================