esentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\">\\n            <tr><td class=\\\"divider px\\\" style=\\\"padding:24px 34px 20px;border-bottom:1px solid #e4e6ea;\\\">\\n              <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n                <td width=\\\"12\\\" valign=\\\"middle\\\" style=\\\"width:12px;padding:0;\\\"><div style=\\\"width:11px;height:11px;min-width:11px;border-radius:50%;background:#C6A87F;font-size:0;line-height:0;\\\">&nbsp;</div></td>\\n                <td valign=\\\"middle\\\" class=\\\"t-strong\\\" style=\\\"padding-left:11px;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:17px;letter-spacing:-.3px;color:#15151f;white-space:nowrap;\\\">Atlantis <span style=\\\"color:#C6A87F;\\\">Global Realty</span></td>\\n              </tr></table>\\n            </td></tr>\\n          </table>\\n\\n          <!-- body -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:30px 34px 6px;\\\">\\n            <p style=\\\"margin:0 0 12px;font-family:'DM Mono',Menlo,monospace;font-size:10px;letter-spacing:2.2px;text-transform:uppercase;color:#C6A87F;\\\">Account security</p>\\n            <h1 class=\\\"t-strong\\\" style=\\\"margin:0 0 14px;font-family:'Inter',Arial,sans-serif;font-weight:800;font-size:29px;line-height:1.14;letter-spacing:-.5px;color:#15151f;\\\">Your password <span style=\\\"color:#C6A87F;\\\">was updated.</span></h1>\\n            <p class=\\\"t-body\\\" style=\\\"margin:0 0 4px;font-family:'DM Mono',Menlo,monospace;font-size:14px;line-height:1.65;color:#55556a;\\\">Hi {{NOMBRE}}, we are confirming that your account password was changed successfully. You can now sign in with the new one.</p>\\n          </td></tr></table>\\n\\n          <!-- CTA -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" align=\\\"left\\\" style=\\\"padding:24px 34px 4px;\\\">\\n            <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n              <td style=\\\"border-radius:13px;background:#C6A87F;\\\">\\n                <a href=\\\"https://app.atlantisglobalrealty.com\\\" target=\\\"_blank\\\" style=\\\"display:inline-block;padding:16px 30px;font-family:'Inter',Arial,sans-serif;font-weight:700;font-size:15px;letter-spacing:-.2px;color:#ffffff;border-radius:13px;\\\">Go to the app &rarr;</a>\\n              </td>\\n            </tr></table>\\n          </td></tr></table>\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:12px 34px 0;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:11px;letter-spacing:.4px;color:#8a8a99;\\\">◷ This change was applied just now.</p>\\n          </td></tr></table>\\n\\n          <!-- security -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <p class=\\\"t-mut\\\" style=\\\"margin:0;font-size:12px;line-height:1.55;color:#5d5d6c;\\\"><b style=\\\"color:inherit;\\\">Was this not you?</b> Contact us right away: someone else may have access to your account.<b style=\\\"display:none\\\"></p>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- signature -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" sty