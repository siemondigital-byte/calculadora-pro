      "parameters": {
        "jsCode": "// Password criptograficamente segura (politica del handoff): sin\n// caracteres ambiguos, 12 + 1 simbolo, barajada con crypto.\nconst crypto = require('crypto');\nconst b = $input.first().json.body || {};\nconst email = (b.email || '').trim().toLowerCase();\nif (!email || email.indexOf('@') < 1) throw new Error('email requerido');\nconst AL = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';\nconst SIM = '!@#$%*?';\nconst pick = (set, n) => Array.from(crypto.randomBytes(n)).map(x => set[x % set.length]).join('');\nconst bruto = pick(AL, 12) + pick(SIM, 1);\nconst password = bruto.split('').map(c => ({ c, o: crypto.randomInt(1e6) }))\n  .sort((a, z) => a.o - z.o).map(x => x.c).join('');\nreturn [{ json: { email, nombre: b.nombre || b.name || '', lang: (b.lang || b.idioma) === 'en' ? 'en' : 'es', password } }];"
      },
      "name": "Generar password",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
