    {
      "parameters": {
        "jsCode": "// Password criptograficamente segura (politica del handoff): sin\n// caracteres ambiguos, 12 + 1 simbolo, barajada con crypto.\nconst crypto = require('crypto');\nconst b = $input.first().json.body || {};\nconst email = (b.email || '').trim().toLowerCase();\nif (!email || email.indexOf('@') < 1) throw new Error('email requerido');\nconst AL = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';\nconst SIM = '!@#$%*?';\nconst pick = (set, n) => Array.from(crypto.randomBytes(n)).map(x => set[x % set.length]).join('');\nconst bruto = pick(AL, 12) + pick(SIM, 1);\nconst password = bruto.split('').map(c => ({ c, o: crypto.randomInt(1e6) }))\n  .sort((a, z) => a.o - z.o).map(x => x.c).join('');\nreturn [{ json: { email, nombre: b.nombre || b.name || '', lang: (b.lang || b.idioma) === 'en' ? 'en' : 'es', password } }];"
      },
      "name": "Generar password",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/auth/v1/admin/users",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email, password: $json.password, email_confirm: true }) }}",
        "options": {}
      },
      "name": "Supabase: crear usuario",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        880,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const T = {\"es\": \"<!DOCTYPE html>\\n<html lang=\\\"es\\\" xmlns=\\\"http://www.w3.org/1999/xhtml\\\" xmlns:v=\\\"urn:schemas-microsoft-com:vml\\\" xmlns:o=\\\"urn:schemas-microsoft-com:office:office\\\">\\n<head>\\n  <meta charset=\\\"utf-8\\\">\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n  <meta http-equiv=\\\"X-UA-Compatible\\\" content=\\\"IE=edge\\\">\\n  <meta name=\\\"x-apple-disable-message-reformatting\\\">\\n  <meta name=\\\"color-scheme\\\" content=\\\"light dark\\\">\\n  <meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\">\\n  <title>Bienvenido al Ciclo de Riqueza Inmobiliaria</title>\\n  <!--[if mso]>\\n  <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>\\n  <![endif]-->\\n  <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n  <link href=\\\"https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&amp;family=Instrument+Sans:wght@400;500;600;700&amp;display=swap\\\" rel=\\\"stylesheet\\\">\\n  <style>\\n    :root { color-scheme: light dark; supported-color-schemes: light dark; }\\n    html, body { margin: 0 !important; padding: 0 !important; width: 100% !important; }\\n    * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }\\n    table { border-collapse: collapse !important; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\\n    img { border: 0; line-height: 100%; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }\\n    a { text-decoration: none; }\\n\\n    /* ====== DARK MODE (se activa solo si el dispositivo está en oscuro) ====== */\\n    @media (prefers-color-scheme: dark) {\\n      .email-bg      { background: #0A0A0C !important; }\\n      .card          { background: #0F1B2D !important; border-color: rgba(230,199,136,0.28) !important; }\\n      .ink           { color: #F4EFE6 !important; }\\n      .body-text     { color: #D7D7D9 !important; }\\n      .muted         { color: #9DA1A8 !important; }\\n      .gold          { color: #E6C788 !important; }\\n      .hairline      { border-color: rgba(215,215,217,0.14) !important; background: rgba(215,215,217,0.14) !important; }\\n      .cred-box      { background: #060608 !important; border-color: rgba(230,199,136,0.30) !important; }\\n      .cred-value    { color: #F4EFE6 !important; }\\n      .ring          { border-color: #E6C788 !important; }\\n      .ring-dot      { background: #E6C788 !important; }\\n      .ring-gap    { background: #0F1B2D !important; }\\n      .btn-primary   { background: #E6C788 !important; color: #0A0A0C !important; border-color: #E6C788 !important; }\\n      .btn-primary a { color: #0A0A0C !important; }\\n      .btn-secondary a { color: #F4EFE6 !important; border-color: rgba(230,199,136,0.45) !important; }\\n      .footer-line   { border-color: rgba(230,199,136,0.18) !important; }\\n    }\\n\\n    /* Móvil */\\n    @media only screen and (max-width: 620px) {\\n      .container { width: 100% !important; }\\n      .px        { padding-left: 24px !important; padding-right: 24px !important; }\\n      .h1        { font-size: 40px !important; line-height: 1.08 !important; }\\n      .btn-cell, .btn-cell a { display: block !important; width: 100% !important; box-sizing: border-box !important; text-align: center !important; }\\n    }\\n  </style>\\n</head>\\n<!--\\n  ============================================================================\\n  CORREO DE COMPRA · Ciclo de Riqueza Inmobiliaria\\n  ----------------------------------------------------------------------------\\n  Pegar este HTML en el nodo \\\"Send Email\\\" / \\\"Email\\\" de n8n (campo HTML).\\n  Variables que n8n debe reemplazar (modo expresión):\\n    {{ $json.nombre }}        ->  nombre del comprador\\n    {{ $json.email }}         ->  usuario / correo de acceso (creado en el sistema)\\n    {{ $json.password }}      ->  contraseña generada automáticamente\\n    {{ $json.membersUrl }}    ->  enlace al Área de Miembros (libro + guías)\\n    {{ $json.appUrl }}        ->  enlace para ingresar al aplicativo\\n    {{ $json.downloadsUrl }}  ->  enlace a los archivos descargables\\n    {{ $json.webUrl }}        ->  (opcional) ver este correo como página\\n  Al abrir el archivo en un navegador, un pequeño script rellena valores de\\n  demostración para previsualizar el diseño. Los clientes de correo ignoran\\n  ese script, por lo que no afecta el envío real.\\n  ============================================================================\\n-->\\n<body class=\\\"email-bg\\\" style=\\\"margin:0; padding:0; background:#ECE6DA; font-family:'Instrument Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;\\\">\\n\\n  <!-- Preheader oculto -->\\n  <div style=\\\"display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all; font-size:1px; line-height:1px; color:#ECE6DA;\\\">\\n    Tu cuenta ya está creada. Aquí están tus accesos al aplicativo y tus archivos descargables.\\n    &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;\\n  </div>\\n\\n  <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" class=\\\"email-bg\\\" style=\\\"background:#ECE6DA;\\\">\\n    <tr>\\n      <td align=\\\"center\\\" style=\\\"padding:0 12px;\\\">\\n\\n        <!-- Ver en navegador -->\\n        <table role=\\\"presentation\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" class=\\\"container\\\" style=\\\"width:600px; max-width:600px;\\\">\\n          <tr>\\n            <td align=\\\"center\\\" style=\\\"padding:18px 0 6px;\\\">\\n              <a href=\\\"{{ $json.webUrl }}\\\" class=\\\"muted\\\" style=\\\"font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:#8A7F6A; text-decoration:none;\\\">Ver este correo en el navegador</a>\\n            </td>\\n          </tr>\\n        </table>\\n\\n        <!-- Tarjeta principal -->\\n        <table role=\\\"presentation\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" class=\\\"container card\\\" style=\\\"width:600px; max-width:600px; background:#FBF8F1; border:1px solid rgba(15,27,45,0.10);\\\">\\n\\n          <!-- Header -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:32px 48px 0;\\\">\\n              <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n                <tr>\\n                  <td align=\\\"left\\\" valign=\\\"middle\\\">\\n                    <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n                      <tr>\\n                        <td valign=\\\"middle\\\" style=\\\"padding-right:12px;\\\">\\n                          <img src=\\\"https://atlantisglobalrealty.com/emails/assets/orbita.png\\\" width=\\\"34\\\" height=\\\"34\\\" alt=\\\"\\\" style=\\\"display:block;border:0;\\\">\\n                        </td>\\n                        <td valign=\\\"middle\\\">\\n                          <span class=\\\"gold\\\" style=\\\"font-size:11px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:#A67C34;\\\">Ciclo de Riqueza Inmobiliaria</span>\\n                        </td>\\n                      </tr>\\n                    </table>\\n                  </td>\\n                  <td align=\\\"right\\\" valign=\\\"middle\\\">\\n                    <span class=\\\"muted\\\" style=\\\"font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:#8A7F6A;\\\">Confirmación de compra</span>\\n                  </td>\\n                </tr>\\n              </table>\\n            </td>\\n          </tr>\\n\\n          <!-- Hero -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:44px 48px 8px;\\\">\\n              <div class=\\\"gold\\\" style=\\\"font-size:12px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:#A67C34; margin-bottom:20px;\\\">Tu acceso está activo</div>\\n              <h1 class=\\\"h1 ink\\\" style=\\\"margin:0 0 22px; font-family:'Bodoni Moda',Didot,Georgia,'Times New Roman',serif; font-weight:800; font-size:56px; line-height:1.05; letter-spacing:-0.01em; color:#0F1B2D;\\\">Bienvenido al <span class=\\\"gold\\\" style=\\\"font-style:italic; color:#A67C34;\\\">Ciclo.</span></h1>\\n              <p class=\\\"body-text\\\" style=\\\"margin:0; font-size:18px; line-height:1.6; color:#3C4452;\\\">Hola <span class=\\\"ink\\\" style=\\\"color:#0F1B2D; font-weight:600;\\\">{{ $json.nombre }}</span>, tu compra está confirmada y tu cuenta ya fue creada en el sistema. Abajo tienes todo: el Área de Miembros con el libro y las guías, el acceso al aplicativo y tus archivos descargables.</p>\\n            </td>\\n          </tr>\\n\\n          <!-- PASO 1 · Área de miembros (libro + guías) -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:36px 48px 0;\\\">\\n              <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" class=\\\"card\\\" style=\\\"border:1px solid rgba(15,27,45,0.14); border-radius:14px;\\\">\\n                <tr>\\n                  <td style=\\\"padding:28px 30px;\\\">\\n                    <div class=\\\"gold\\\" style=\\\"font-size:11px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:#A67C34; margin-bottom:12px;\\\">Paso 1 · Libro y guías</div>\\n                    <h2 class=\\\"ink\\\" style=\\\"margin:0 0 12px; font-family:'Bodoni Moda',Georgia,serif; font-weight:700; font-size:25px; line-height:1.16; color:#0F1B2D;\\\">El libro y las dos guías están en el Área de Miembros</h2>\\n                    <p class=\\\"body-text\\\" style=\\\"margin:0 0 22px; font-size:15px; line-height:1.6; color:#3C4452;\\\">Las credenciales del Área de Miembros te llegan <strong class=\\\"ink\\\" style=\\\"color:#0F1B2D;\\\">directamente desde la plataforma donde compraste</strong> (Hotmart, ClickBank u otra), en un correo aparte. Revisa también spam o promociones si no lo ves.</p>\\n                    <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n                      <tr>\\n                        <td class=\\\"btn-cell btn-primary\\\" align=\\\"center\\\" bgcolor=\\\"#0F1B2D\\\" style=\\\"background:#0F1B2D; border:1px solid #0F1B2D; border-radius:3px;\\\">\\n                          <a href=\\\"{{ $json.membersUrl }}\\\" target=\\\"_blank\\\" style=\\\"display:block; padding:17px 32px; font-family:'Instrument Sans',Helvetica,Arial,sans-serif; font-size:16px; font-weight:600; color:#F4EFE6; text-decoration:none; letter-spacing:0.01em;\\\">Ingresar al área de miembros &nbsp;&rarr;</a>\\n                        </td>\\n                      </tr>\\n                    </table>\\n                  </td>\\n                </tr>\\n              </table>\\n            </td>\\n          </tr>\\n\\n          <!-- PASO 2 · Aplicativo (credenciales creadas por el sistema) -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:22px 48px 0;\\\">\\n              <div class=\\\"gold\\\" style=\\\"font-size:11px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; color:#A67C34; margin-bottom:14px;\\\">Paso 2 · Calculadora Pro</div>\\n              <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" class=\\\"cred-box\\\" style=\\\"background:#0F1B2D; border:1px solid rgba(166,124,52,0.40); border-radius:14px;\\\">\\n                <tr>\\n                  <td style=\\\"padding:30px 34px;\\\">\\n                    <div style=\\\"font-size:11px; font-weight:700; letter-spacing:0.20em; text-transform:uppercase; color:#E6C788; margin-bottom:8px;\\\">Tus credenciales del aplicativo</div>\\n                    <div style=\\\"font-size:13px; line-height:1.55; color:#9DA1A8; margin-bottom:22px;\\\">Creadas automáticamente para ti. Sirven solo para el aplicativo (la Calculadora Pro), no para el Área de Miembros.</div>\\n\\n                    <div style=\\\"font-size:11px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; color:#9DA1A8; margin-bottom:7px;\\\">Usuario</div>\\n                    <div class=\\\"cred-value\\\" style=\\\"font-family:'SF Mono','Courier New',monospace; font-size:17px; color:#F4EFE6; word-break:break-all; padding-bottom:20px; border-bottom:1px solid rgba(215,215,217,0.14);\\\">{{ $json.email }}</div>\\n\\n                    <div style=\\\"font-size:11px; font-weight:600; letter-spacing:0.14em; text-transform:uppercase; color:#9DA1A8; margin:20px 0 7px;\\\">Contraseña temporal</div>\\n                    <div class=\\\"cred-value\\\" style=\\\"font-family:'SF Mono','Courier New',monospace; font-size:17px; color:#F4EFE6; word-break:break-all;\\\">{{ $json.password }}</div>\\n\\n                    <div style=\\\"margin-top:22px; font-size:13px; line-height:1.55; color:#9DA1A8;\\\">Por seguridad, te recomendamos cambiar esta contraseña la primera vez que ingreses.</div>\\n                  </td>\\n                </tr>\\n              </table>\\n              <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" style=\\\"margin-top:16px;\\\">\\n                <tr>\\n                  <td class=\\\"btn-cell btn-primary\\\" align=\\\"center\\\" bgcolor=\\\"#0F1B2D\\\" style=\\\"background:#0F1B2D; border:1px solid #0F1B2D; border-radius:3px;\\\">\\n                    <a href=\\\"{{ $json.appUrl }}\\\" target=\\\"_blank\\\" style=\\\"display:block; padding:18px 32px; font-family:'Instrument Sans',Helvetica,Arial,sans-serif; font-size:16px; font-weight:600; color:#F4EFE6; text-decoration:none; letter-spacing:0.01em;\\\">Ingresar al aplicativo &nbsp;&rarr;</a>\\n                  </td>\\n                </tr>\\n              </table>\\n            </td>\\n          </tr>\\n\\n          <!-- Descargables -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:14px 48px 4px;\\\">\\n              <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n                <tr>\\n                  <td class=\\\"btn-cell btn-secondary\\\" align=\\\"center\\\" style=\\\"border-radius:3px;\\\">\\n                    <a href=\\\"{{ $json.downloadsUrl }}\\\" target=\\\"_blank\\\" style=\\\"display:block; padding:17px 32px; font-family:'Instrument Sans',Helvetica,Arial,sans-serif; font-size:16px; font-weight:600; color:#0F1B2D; text-decoration:none; border:1px solid rgba(15,27,45,0.30); border-radius:3px;\\\">Descargar archivos adicionales</a>\\n                  </td>\\n                </tr>\\n              </table>\\n            </td>\\n          </tr>\\n\\n          <!-- Divisor -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:36px 48px 0;\\\">\\n              <div class=\\\"hairline\\\" style=\\\"height:1px; background:rgba(15,27,45,0.10); font-size:0; line-height:0;\\\">&nbsp;</div>\\n            </td>\\n          </tr>\\n\\n          <!-- Qué incluye tu acceso -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:32px 48px 0;\\\">\\n              <div class=\\\"gold\\\" style=\\\"font-size:11px; font-weight:700; letter-spacing:0.20em; text-transform:uppercase; color:#A67C34; margin-bottom:20px;\\\">Qué incluye tu acceso</div>\\n              <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\">\\n                <tr>\\n                  <td valign=\\\"top\\\" width=\\\"32\\\" style=\\\"padding:6px 0;\\\"><span style=\\\"font-family:'Bodoni Moda',Georgia,serif; font-weight:700; font-size:15px; col