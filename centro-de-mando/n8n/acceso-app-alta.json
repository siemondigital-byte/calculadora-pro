          "conditions": [
            {
              "leftValue": "={{ $json.query.k || '' }}",
              "rightValue": "REEMPLAZAR_CRON_KEY",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "¿Clave valida?",
      "type": "n8n-nodes-base.if",
