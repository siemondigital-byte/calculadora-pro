   </tr>\\n              </table>\\n            </td>\\n          </tr>\\n\\n          <!-- Soporte -->\\n          <tr>\\n            <td class=\\\"px\\\" style=\\\"padding:34px 48px 40px;\\\">\\n              <div class=\\\"hairline\\\" style=\\\"height:1px; background:rgba(15,27,45,0.10); font-size:0; line-height:0; margin-bottom:26px;\\\">&nbsp;</div>\\n              <div class=\\\"muted\\\" style=\\\"font-size:11px; font-weight:600; letter-spacing:0.16em; text-transform:uppercase; color:#8A7F6A; margin-bottom:8px;\\\">¿Algún problema con tu acceso?</div>\\n              <p class=\\\"body-text\\\" style=\\\"margin:0; font-size:14px; line-height:1.6; color:#3C4452;\\\">Escríbenos a <a href=\\\"mailto:cicloderiqueza@atlantisglobalrealty.com\\\" class=\\\"gold\\\" style=\\\"color:#A67C34; font-weight:600; text-decoration:none;\\\">cicloderiqueza@atlantisglobalrealty.com</a> con el nombre y el correo de tu compra. Respondemos en menos de 24 horas hábiles.</p>\\n            </td>\\n          </tr>\\n        </table>\\n\\n        <!-- Footer -->\\n        <table role=\\\"presentation\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" border=\\\"0\\\" class=\\\"container\\\" style=\\\"width:600px; max-width:600px;\\\">\\n          <tr>\\n            <td class=\\\"px footer-line\\\" style=\\\"padding:28px 48px 40px; border-top:1px solid rgba(15,27,45,0.10);\\\">\\n              <p class=\\\"muted\\\" style=\\\"margin:0 0 6px; font-size:12px; line-height:1.6; color:#8A7F6A;\\\">Ciclo de Riqueza Inmobiliaria · en alianza con Atlantis Global Realty</p>\\n              <p class=\\\"muted\\\" style=\\\"margin:0; font-size:11px; line-height:1.6; color:#A39884;\\\">Contenido educativo. No es asesoría financiera, legal ni tributaria. Recibes este correo porque completaste una compra en Ciclo de Riqueza Inmobiliaria.</p>\\n            </td>\\n          </tr>\\n        </table>\\n\\n      </td>\\n    </tr>\\n  </table>\\n\\n  <!-- Demo solo para previsualización en