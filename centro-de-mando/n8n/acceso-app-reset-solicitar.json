spacing:.4px;color:#8a8a99;\\\">◷ This link expires in 60 minutes and can only be used once.</p>\\n          </td></tr></table>\\n\\n          <!-- fallback -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:22px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <div class=\\\"t-faint\\\" style=\\\"font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;color:#8a8a99;margin-bottom:6px;\\\">If the button doesn't work, copy this link</div>\\n              <a href=\\\"{{RESET_LINK}}\\\" style=\\\"color:#1499c9;font-size:11.5px;word-break:break-all;\\\">{{RESET_LINK}}</a>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- security -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <p class=\\\"t-mut\\\" style=\\\"margin:0;font-size:12px;line-height:1.55;color:#5d5d6c;\\\"><b style=\\\"color:inherit;\\\">Didn't request this?</b> Ignore this email and your password will stay the same. Never share this link; the Atlantis Global Realty team will never ask for your password.</p>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- signature -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 6px;\\\">\\n            <p class=\\\"t-mut\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:12.5px;color:#5d5d6c;\\\">Any questions, just reply to this email. See you inside.<br><b style=\\\"font-family:'Inter',Arial,sans-serif;\\\">the Atlantis Global Realty team</b></p>\\n          </td></tr></table>\\n\\n          <!-- footer -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"divider px\\\" style=\\\"padding:20px 34px 28px;border-top:1px solid #e4e6ea;margin-top:16px;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:16px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;line-height:1.6;color:#8a8a99;\\\">You received this email because a password change was requested for your Atlantis Global Realty account.</p>\\n            <p class=\\\"t-faint\\\" style=\\\"margin:8px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;color:#8a8a99;\\\">© 2026 Atlantis Global Realty · <a href=\\\"mailto:wealthcycle@atlantisglobalrealty.com\\\" class=\\\"t-mut\\\" style=\\\"color:#5d5d6c;\\\">Support</a></p>\\n          </td></tr></table>\\n\\n        </td></tr>\\n      </table>\\n    </td></tr>\\n  </table>\\n</body>\\n</html>\"};\nconst d = $('Crear token').first().json;\nd.reset_link = 'https://wealthcycle-app.atlantisglobalrealty.com/reset.html?token='\n  + encodeURIComponent(d.token) + '&lang=' + d.lang;\nconst lang = (d.lang === 'en') ? 'en' : 'es';\nlet html = T[lang]\n  .split('{{NOMBRE}}').join(d.nombre || '')\n  .split('{{EMAIL}}').join(d.email || '')\n  .split('{{PASSWORD}}').join(d.password || '')\n  .split('{{RESET_LINK}}').join(d.reset_link || '');\nconst subject = lang === 'en' ? \"Reset your password \\u00b7 Calculator Pro\" : \"Restablece tu contrase\\u00f1a \\u00b7 Calculadora Pro\";\nconst from = lang === 'en'\n  ? 'The Real Estate Wealth Cycle <wealthcycle@atlantisglobalrealty.com>'\n  : 'Ciclo de Riqueza Inmobiliaria <cicloderiqueza@atlantisglobalrealty.com>';\nreturn [{ json: { from, to: d.email, subject, html } }];"
