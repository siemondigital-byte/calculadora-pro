\\\"color-scheme\\\" content=\\\"light dark\\\" />\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\" />\\n<title>Reset your password · Atlantis Global Realty</title>\\n<style>\\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\\n  body,table,td,a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\\n  table,td { mso-table-lspace:0pt; mso-table-rspace:0pt; }\\n  img { border:0; line-height:100%; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }\\n  a { text-decoration:none; }\\n  @media (prefers-color-scheme: dark) {\\n    .bg      { background:#0a0a0f !important; }\\n    .card    { background:#14141d !important; border-color:#262630 !important; }\\n    .divider { border-color:#262630 !important; }\\n    .soft    { background:#1c1c27 !important; border-color:#262630 !important; }\\n    .t-strong{ color:#f0f0f8 !important; }\\n    .t-body  { color:#b9b9c8 !important; }\\n    .t-mut   { color:#8a8a9e !important; }\\n    .t-faint { color:#6a6a7c !important; }\\n    .pre     { background:#1c1c27 !important; color:#6a6a7c !important; }\\n  }\\n  @media (max-width:600px){\\n    .px { padding-left:22px !important; padding-right:22px !important; }\\n    .container { width:100% !important; }\\n  }\\n</style>\\n</head>\\n<body class=\\\"bg\\\" style=\\\"margin:0;padding:0;background:#eef0f3;\\\">\\n  <div style=\\\"display:none;max-height:0;overflow:hidden;opacity:0;\\\">Create a new password for your account. The link expires in 60 minutes.</div>\\n  <table role=\\\"presentation\\\" class=\\\"bg\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#eef0f3;\\\">\\n    <tr><td align=\\\"center\\\" style=\\\"padding:30px 14px 60px;\\\">\\n      <table role=\\\"presentation\\\" class=\\\"container\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:600px;max-width:600px;\\\">\\n\\n        <!-- card -->\\n        <tr><td class=\\\"card\\\" 