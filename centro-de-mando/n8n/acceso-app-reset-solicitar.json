    {
      "parameters": {
        "jsCode": "// Token propio (sin PKCE de Supabase: funciona en cualquier navegador\n// o dispositivo). Vence en 60 minutos; un solo uso.\nconst crypto = require('crypto');\nconst b = $input.first().json.body || {};\nconst email = (b.email || '').trim().toLowerCase();\nif (!email || email.indexOf('@') < 1) throw new Error('email requerido');\nconst token = crypto.randomBytes(16).toString('hex');\nconst expira = new Date(Date.now() + 60 * 60 * 1000).toISOString();\nconst lang = (b.lang || b.idioma) === 'en' ? 'en' : 'es';\nreturn [{ json: { token, email, app: b.app || 'calculadora', lang, expira_en: expira, nombre: b.nombre || '' } }];"
      },
      "name": "Crear token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/password_resets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ token: $json.token, email: $json.email, app: $json.app, lang: $json.lang, expira_en: $json.expira_en }) }}",
        "options": {}
      },
      "name": "Supabase: guardar token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        680,
        300
      ]
    },
