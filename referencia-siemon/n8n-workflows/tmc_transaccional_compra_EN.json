s":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.3,"position":[512,128],"id":"f7d6c0bb-024a-40ad-8891-4ee4c1a13767","name":"Creación-Firebase","credentials":{"googleApi":{"id":"rZN8W7rYWrK7WQop","name":"Google Service Account account 3"}}},{"parameters":{"mode":"combine","combineBy":"combineByPosition","options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[784,16],"id":"4f23cb3d-5d30-484d-9ee6-25a403cdfe92","name":"Merge"},{"parameters":{"fromEmail":"The Money Command <hello@themoneycommand.com>","toEmail":"={{ $('Webhook').item.json.body.data.buyer.email }}","subject":"🗝️ This is your access keys to the system. Enjoy!","html":"=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>The Money Command - Welcome</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Mono:wght@400;500&display=swap\" />\n</head>\n<body style=\"margin:0; padding:0; background-color:#eef0f3; font-family:'DM Mono', ui-monospace, Menlo, monospace;\">\n\n  <!-- Main Container (Forces global centering) -->\n  <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#eef0f3; table-layout: fixed;\">\n    <tr>\n      <td align=\"center\" style=\"padding: 10px 18px 80px;\">\n        \n        <!-- Web Version Link (Centered) -->\n        <table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 600px; max-width: 100%; margin: 20px auto 15px;\">\n          <tr>\n            <td align=\"center\" style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11px; color:#8a8a99;\">\n              Email not displaying correctly? To view the HTML version, <a href=\"https://themoneycommand.com/emails/confirmation/?email={{ encodeURIComponent($json.email) }}&password={{ encodeURIComponent($('Generar_password').item.json.password) }}\" target=\"_blank\" style=\"color:#1499c9; text-decoration:underline;\">click here</a>.\n            </td>\n          </tr>\n        </table>\n        \n        <!-- Main Card (600px fixed width, centered) -->\n        <table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 600px; max-width: 100%; background-color:#ffffff; border:1px solid #e4e6ea; border-radius:18px; box-shadow:0 18px 48px rgba(15,15,35,0.08); overflow:hidden; border-collapse:separate; margin: 0 auto;\">\n          \n          <!-- Header / Logo -->\n          <tr>\n            <td style=\"padding:26px 34px 22px; border-bottom:1px solid #e4e6ea;\">\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                  <td width=\"11\" valign=\"middle\" style=\"padding-right:11px;\">\n                    <div style=\"width:11px; height:11px; background-color:#07b277; border-radius:50px;\"></div>\n                  </td>\n                  <td valign=\"middle\">\n                    <div style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:17px; color:#15151f; letter-spacing:-0.3px; line-height:1.2;\">\n                      The Money <span style=\"color:#07b277;\">Command</span>\n                    </div>\n                    <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:9px; letter-spacing:2.4px; text-transform:uppercase; color:#8a8a99; margin-top:3px;\">\n                      Access to your ecosystem\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Message Body -->\n          <tr>\n            <td style=\"padding:34px 34px 20px;\">\n              \n              <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:10px; letter-spacing:2.2px; text-transform:uppercase; color:#07b277; font-weight:500; margin-bottom:12px;\">\n                Your access is verified\n              </div>\n              \n              <h1 style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:28px; color:#15151f; letter-spacing:-0.5px; line-height:1.15; margin:0 0 14px 0;\">\n                Welcome! <span style=\"color:#07b277;\">Your credentials are ready.</span>\n              </h1>\n              \n              <p style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:14px; line-height:1.6; color:#5d5d6c; margin:0 0 24px 0;\">\n                Thank you for joining The Money Command. Below you will find your global credentials and the direct access buttons for both web apps along with your downloadable resources. Use this exact same data across the entire ecosystem.\n              </p>\n\n              <!-- Section 1: Application Credentials -->\n              <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11px; letter-spacing:1px; text-transform:uppercase; color:#15151f; font-weight:700; margin-bottom:8px;\">\n                Ecosystem Credentials\n              </div>\n              \n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f6f8; border:1px solid #e4e6ea; border-radius:13px; margin-bottom:28px; border-collapse:separate;\">\n                <tr>\n                  <td style=\"padding:13px 18px; border-bottom:1px dashed #e4e6ea;\">\n                    <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                      <tr>\n                        <td width=\"35%\" style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:9.5px; letter-spacing:1.8px; text-transform:uppercase; color:#8a8a99;\">Global User</td>\n                        <td align=\"right\" style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:13.5px; font-weight:500; color:#1499c9; word-break:break-all;\">{{ $json.email }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n                <tr>\n                  <td style=\"padding:13px 18px;\">\n                    <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                      <tr>\n                        <td width=\"35%\" style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:9.5px; letter-spacing:1.8px; text-transform:uppercase; color:#8a8a99;\">Global Password</td>\n                        <td align=\"right\" style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:13.5px; font-weight:500; color:#1499c9; word-break:break-all;\">{{ $('Generar_password').item.json.password || 'Assigned upon registration' }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- BUTTONS TABLE / ECOSYSTEM ACCESS -->\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-bottom:28px;\">\n                \n                <!-- Button 1: Mindset & Goals App -->\n                <tr>\n                  <td style=\"padding-bottom:13px;\">\n                    <a href=\"https://themoneycommand.com/mind-guide/?user={{ encodeURIComponent($json.email) }}\" target=\"_blank\" style=\"text-decoration:none; display:block;\">\n                      <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#ffffff; border:1px solid #e4e6ea; border-radius:13px; padding:15px 18px;\">\n                        <tr>\n                          <td width=\"44\" valign=\"middle\" style=\"padding-right:15px;\">\n                            <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:rgba(7,178,119,0.1); border:1px solid rgba(7,178,119,0.3); border-radius:11px; width:44px; height:44px;\">\n                              <tr>\n                                <td align=\"center\" valign=\"middle\" style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:18px; color:#07b277;\">◆</td>\n                              </tr>\n                            </table>\n                          </td>\n                          <td valign=\"middle\">\n                            <div style=\"font-family:'Syne', sans-serif; font-weight:700; font-size:15px; color:#15151f; margin-bottom:2px;\">Mindset & Goals App</div>\n                            <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11.5px; color:#5d5d6c; line-height:1.4;\">Purpose, 90-day cycles, habits, and thermostat.</div>\n                          </td>\n                          <td width=\"20\" align=\"right\" valign=\"middle\" style=\"font-family:'Syne', sans-serif; font-size:18px; color:#07b277;\">&rarr;</td>\n                        </tr>\n                      </table>\n                    </a>\n                  </td>\n                </tr>\n                \n                <!-- Button 2: Personal Finances App -->\n                <tr>\n                  <td style=\"padding-bottom:13px;\">\n                    <a href=\"https://themoneycommand.com/finances-guide/?user={{ encodeURIComponent($json.email) }}\" target=\"_blank\" style=\"text-decoration:none; display:block;\">\n                      <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#ffffff; border:1px solid #e4e6ea; border-radius:13px; padding:15px 18px;\">\n                        <tr>\n                          <td width=\"44\" valign=\"middle\" style=\"padding-right:15px;\">\n                            <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:rgba(20,153,201,0.1); border:1px solid rgba(20,153,201,0.3); border-radius:11px; width:44px; height:44px;\">\n                              <tr>\n                                <td align=\"center\" valign=\"middle\" style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:18px; color:#1499c9;\">▣</td>\n                              </tr>\n                            </table>\n                          </td>\n                          <td valign=\"middle\">\n                            <div style=\"font-family:'Syne', sans-serif; font-weight:700; font-size:15px; color:#15151f; margin-bottom:2px;\">Personal Finances App</div>\n                            <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11.5px; color:#5d5d6c; line-height:1.4;\">Your Freedom Number, dashboard, and financial coach.</div>\n                          </td>\n                          <td width=\"20\" align=\"right\" valign=\"middle\" style=\"font-family:'Syne', sans-serif; font-size:18px; color:#1499c9;\">&rarr;</td>\n                        </tr>\n                      </table>\n                    </a>\n                  </td>\n                </tr>\n\n                <!-- Button 3: Downloadable Resources -->\n                <tr>\n                  <td style=\"padding-bottom:13px;\">\n                    <a href=\"https://drive.google.com/drive/folders/1NTyZmJoLTX9uGYrcZQVYIOJ_XBsxYEBG?usp=drive_link\" target=\"_blank\" style=\"text-decoration:none; display:block;\">\n                      <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#ffffff; border:1px solid #e4e6ea; border-radius:13px; padding:15px 18px;\">\n                        <tr>\n                          <td width=\"44\" valign=\"middle\" style=\"padding-right:15px;\">\n                            <table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:rgba(189,139,22,0.1); border:1px solid rgba(189,139,22,0.3); border-radius:11px; width:44px; height:44px;\">\n                              <tr>\n                                <td align=\"center\" valign=\"middle\" style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:18px; color:#bd8b16;\">▼</td>\n                              </tr>\n                            </table>\n                          </td>\n                          <td valign=\"middle\">\n                            <div style=\"font-family:'Syne', sans-serif; font-weight:700; font-size:15px; color:#15151f; margin-bottom:2px;\">Downloadable Resources</div>\n                            <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11.5px; color:#5d5d6c; line-height:1.4;\">Book, workbook, podcast, and PDF bonuses.</div>\n                          </td>\n                          <td width=\"20\" align=\"right\" valign=\"middle\" style=\"font-family:'Syne', sans-serif; font-size:18px; color:#bd8b16;\">&rarr;</td>\n                        </tr>\n                      </table>\n                    </a>\n                  </td>\n                </tr>\n\n              </table>\n\n              <!-- PWA Info Block -->\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f6f8; border:1px solid #e4e6ea; border-radius:13px; padding:18px 20px; margin-bottom:24px;\">\n                <tr>\n                  <td>\n                    <h3 style=\"font-family:'Syne', sans-serif; font-weight:700; font-size:14.5px; color:#15151f; margin:0 0 6px 0;\">\n                      <span style=\"color:#1499c9; margin-right:6px; font-family:'Syne', sans-serif;\">▲</span> Use them as an app (Progressive Web App)\n                    </h3>\n                    <p style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:12.5px; color:#5d5d6c; margin:0 0 12px 0; line-height:1.5;\">\n                      Both apps are PWAs: they run in the browser, but you can install them on your home screen to open them like a native app, in full screen with a direct shortcut. Open the app link and follow these steps:\n                    </p>\n                    \n                    <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:12px; color:#15151f; margin-bottom:8px; line-height:1.4;\">\n                      <span style=\"font-family:'DM Mono', monospace; background-color:#07b277; color:#ffffff; font-size:9px; font-weight:500; padding:2px 6px; border-radius:4px; display:inline-block; margin-right:6px; min-width:54px; text-align:center;\">IPHONE</span> \n                      In Safari, tap <b>Share</b> (square with an arrow) and select <b>Add to Home Screen</b>.\n                    </div>\n                    <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:12px; color:#15151f; margin-bottom:8px; line-height:1.4;\">\n                      <span style=\"font-family:'DM Mono', monospace; background-color:#1499c9; color:#ffffff; font-size:9px; font-weight:500; padding:2px 6px; border-radius:4px; display:inline-block; margin-right:6px; min-width:54px; text-align:center;\">ANDROID</span> \n                      In Chrome, tap the <b>⋮</b> menu and choose <b>Install app</b> (or <b>Add to Home Screen</b>).\n                    </div>\n                    <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:12px; color:#15151f; line-height:1.4;\">\n                      <span style=\"font-family:'DM Mono', monospace; background-color:#07b277; color:#ffffff; font-size:9px; font-weight:500; padding:2px 6px; border-radius:4px; display:inline-block; margin-right:6px; min-width:54px; text-align:center;\">PC / MAC</span> \n                      In Chrome or Edge, click the <b>Install</b> icon located in the address bar.\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:12.5px; line-height:1.6; color:#5d5d6c; margin:24px 0 0 0;\">\n                If you have any questions, simply reply to this email. See you inside.<br />\n                <span style=\"font-family:'Syne', sans-serif; font-weight:700; color:#15151f; display:inline-block; margin-top:4px;\">The Money Command Team</span>\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Footer / Legals -->\n          <tr>\n            <td style=\"padding:20px 34px 30px; border-top:1px solid #e4e6ea; background-color:#ffffff; font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11px; color:#8a8a99; text-align:left;\">\n              You are receiving this email because you purchased The Money Command. Your access credentials are linked to your purchase account and are non-transferable.<br><br>\n              © 2026 The Money Command · \n              <a href=\"https://themoneycommand.com/privacy.html\" target=\"_blank\" style=\"color:#5d5d6c; text-decoration:underline; font-family:'DM Mono', monospace;\">Privacy</a> · \n              <a href=\"https://themoneycommand.com/terms.html\" target=\"_blank\" style=\"color:#5d5d6c; text-decoration:underline; font-family:'DM Mono', monospace;\">Terms</a> · \n              <a href=\"https://hotmart.com/en/club/the-money-command/community/15292578\" target=\"_blank\" style=\"color:#5d5d6c; text-decoration:underline; font-family:'DM Mono', monospace;\">Support</a>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>","options":{}},"type":"n8n-nodes-base.emailSend","typeVersion":2.1,"position":[1008,16],"id":"1b0553f4-011e-4d4f-84f2-0085ae535056","name":"Send_email_english","webhookId":"1c850fdc-d959-464d-bf21-7a9785ad2c93","credentials":{"smtp":{"id":"9z3M64F5ALuv1uK6","name":"SMTP account"}}},{"parameters":{"jsCode":"const expected = 'ekotYcoAnjISa2wObz26VUVuFnqZt3476304a7-b1e9-4ec1-9d19-d8cacae7b8ae';\nconst got = ($input.first().json.headers || {})['x-hotmart-hottok'];\nif (got !== expected) { throw new Error('hottok inválido — aviso rechazado (posible falso)'); }\nreturn $input.all();"},"id":"hk000000-0000-4000-8000-0000000d1h01","name":"Validar hottok","type":"n8n-nodes-base.code","typeVersion":2,"position":[40,480]},{"parameters":{"operation":"executeQuery","query":"WITH m AS (SELECT producto, es_fundador, idioma FROM producto_hotmart_map WHERE hotmart_product_id = $1), c AS ( INSERT INTO contactos (nombre, email, telefono, idioma, tipo) VALUES ($2, $3, NULLIF($4,''), COALESCE((SELECT idioma FROM m), $5::idioma_enum), 'comprador') ON CONFLICT (email) DO UPDATE SET nombre=EXCLUDED.nombre, telefono=COALESCE(EXCLUDED.telefono, contactos.telefono), actualizado_en=now() RETURNING id), af_ex AS ( SELECT id FROM afiliados WHERE NULLIF($7,'') IS NOT NULL AND (codigo = $7 OR enlace ILIKE '%'||$7) LIMIT 1), af_new AS ( INSERT INTO afiliados (codigo, nombre, enlace, comision_pct, estado, alta) SELECT $7, NULLIF($12,''), $7, 60.00, 'activo', CURRENT_DATE WHERE NULLIF($7,'') IS NOT NULL AND NOT EXISTS (SELECT 1 FROM af_ex) ON CONFLICT (codigo) DO NOTHING RETURNING id), af AS (SELECT id FROM af_ex UNION ALL SELECT id FROM af_new), v AS ( INSERT INTO ventas (transaccion_id, contacto_id, afiliado_id, producto, producto_hotmart, monto, moneda, fuente, es_fundador, fecha) SELECT $6, c.id, (SELECT id FROM af LIMIT 1), COALESCE((SELECT producto FROM m),'Bundle'::producto_enum), $8, $9::numeric, $10, 'hotmart', COALESCE((SELECT es_fundador FROM m),false), $11::date FROM c ON CONFLICT (transaccion_id) DO NOTHING RETURNING id, es_fundador), cupo AS ( UPDATE oferta SET cupos_vendidos = cupos_vendidos + 1 WHERE id=(SELECT id FROM oferta ORDER BY id LIMIT 1) AND EXISTS (SELECT 1 FROM v WHERE es_fundador=true) RETURNING cupos_vendidos) SELECT (SELECT id FROM c) AS contacto_id, (SELECT id FROM v) AS venta_id, (SELECT id FROM af LIMIT 1) AS afiliado_id, COALESCE((SELECT producto FROM m)::text,'(sin mapear)') AS producto, (SELECT cupos_vendidos FROM cupo) AS cupos_vendidos;","options":{"queryReplacement":"={{ [$('Webhook').item.json.body.data.product.id, ($('Webhook').item.json.body.data.buyer.first_name||'')+' '+($('Webhook').item.json.body.data.buyer.last_name||''), $('Webhook').item.json.body.data.buyer.email, $('Webhook').item.json.body.data.buyer.checkout_phone||'', 'en', $('Webhook').item.json.body.data.purchase.transaction, ($('Webhook').item.json.body.data.affiliates&&$('Webhook').item.json.body.data.affiliates[0]?$('Webhook').item.json.body.data.affiliates[0].affiliate_code:''), $('Webhook').item.json.body.data.product.name||'', $('Webhook').item.json.body.data.purchase.price.value, $('Webhook').item.json.body.data.purchase.price.currency_value||'USD', DateTime.fromMillis(Number($('Webhook').item.json.body.data.purchase.order_date||$('Webhook').item.json.body.creation_date)).toFormat('yyyy-MM-dd'), ($('Webhook').item.json.body.data.affiliates&&$('Webhook').item.json.body.data.affiliates[0]?($('Webhook').item.json.body.data.affiliates[0].name||''):'')] }}"}},"id":"pg000000-0000-4000-8000-0000000d1f01","name":"Registrar en CRM (Postgres)","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[200,480],"credentials":{"postgres":{"id":"crmPgMoneyCmd001","name":"Postgres CRM (money-command-db)"}}}],"connections":{"Webhook":{"main":[[{"node":"Validar hottok","type":"main","index":0}]]},"Generar_password":{"main":[[{"node":"Creación-Firebase","type":"main","index":0},{"node":"Creación-Superbase","type":"main","index":0}]]},"Creación-Superbase":{"main":[[{"node":"Merge","type":"main","index":0}]]},"Creación-Firebase":{"main":[[{"node":"Merge","type":"main","index":1}]]},"Merge":{"main":[[{"node":"Send_email_english","type":"main","index":0}]]},"Validar hottok":{"main":[[{"node":"Registrar en CRM (Postgres)","type":"main","index":0}]]},"Registrar en CRM (Postgres)":{"main":[[{"node":"Generar_password","type":"main","index":0}]]}},"nodeGroups":[],"authors":"import","name":null,"description":null,"autosaved":false,"workflowPublishHistory":[]}}