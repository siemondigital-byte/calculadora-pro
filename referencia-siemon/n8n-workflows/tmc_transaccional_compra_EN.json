ontainer (Forces global centering) -->\n  <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#eef0f3; table-layout: fixed;\">\n    <tr>\n      <td align=\"center\" style=\"padding: 10px 18px 80px;\">\n        \n        <!-- Web Version Link (Centered) -->\n        <table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 600px; max-width: 100%; margin: 20px auto 15px;\">\n          <tr>\n            <td align=\"center\" style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11px; color:#8a8a99;\">\n              Email not displaying correctly? To view the HTML version, <a href=\"https://themoneycommand.com/emails/confirmation/?email={{ encodeURIComponent($json.email) }}&password={{ encodeURIComponent($('Generar_password').item.json.password) }}\" target=\"_blank\" style=\"color:#1499c9; text-decoration:underline;\">click here</a>.\n            </td>\n          </tr>\n        </table>\n        \n        <!-- Main Card (600px fixed width, centered) -->\n        <table width=\"600\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"width: 600px; max-width: 100%; background-color:#ffffff; border:1px solid #e4e6ea; border-radius:18px; box-shadow:0 18px 48px rgba(15,15,35,0.08); overflow:hidden; border-collapse:separate; margin: 0 auto;\">\n          \n          <!-- Header / Logo -->\n          <tr>\n            <td style=\"padding:26px 34px 22px; border-bottom:1px solid #e4e6ea;\">\n              <table width=\"100%\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                <tr>\n                  <td width=\"11\" valign=\"middle\" style=\"padding-right:11px;\">\n                    <div style=\"width:11px; height:11px; background-color:#07b277; border-radius:50px;\"></div>\n                  </td>\n                  <td valign=\"middle\">\n                    <div style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:17px; color:#15151f; letter-spacing:-0.3px; line-height:1.2;\">\n                      The Money <span style=\"color:#07b277;\">Command</span>\n                    </div>\n                    <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:9px; letter-spacing:2.4px; text-transform:uppercase; color:#8a8a99; margin-top:3px;\">\n                      Access to your ecosystem\n                    </div>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Message Body -->\n          <tr>\n            <td style=\"padding:34px 34px 20px;\">\n              \n              <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:10px; letter-spacing:2.2px; text-transform:uppercase; color:#07b277; font-weight:500; margin-bottom:12px;\">\n                Your access is verified\n              </div>\n              \n              <h1 style=\"font-family:'Syne', sans-serif; font-weight:800; font-size:28px; color:#15151f; letter-spacing:-0.5px; line-height:1.15; margin:0 0 14px 0;\">\n                Welcome! <span style=\"color:#07b277;\">Your credentials are ready.</span>\n              </h1>\n              \n              <p style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:14px; line-height:1.6; color:#5d5d6c; margin:0 0 24px 0;\">\n                Thank you for joining The Money Command. Below you will find your global credentials and the direct access buttons for both web apps along with your downloadable resources. Use this exact same data across the entire ecosystem.\n              </p>\n\n              <!-- Section 1: Application Credentials -->\n              <div style=\"font-family:'DM Mono', ui-monospace, Menlo, monospace; font-size:11px; letter-spacing:1px; text-transform:uppercase; color:#15151f; font-weight:700; margin-bottom:8px;\">\n                Ecosystem Credentials\n              </div>\n              \n              <table width=\"100%\" borde