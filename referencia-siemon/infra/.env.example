# Variables de entorno del motor (copia a .env y rellena con los valores de ATLANTIS).
# NUNCA subas el .env real a git ni a ningún lado público.

# --- IA / núcleo ---
ANTHROPIC_API_KEY=REEMPLAZAR
CRM_PASSWORD=REEMPLAZAR            # contraseña única del Centro de Mando (también el Bearer que usan los workflows de n8n)
TOKEN_SECRET=REEMPLAZAR            # secreto para firmar tokens internos (baja/unsubscribe)
CRON_KEY=REEMPLAZAR               # clave que exigen los endpoints disparados por cron

# --- Publicación web (FTP a Hostinger u otro) ---
FTP_HOST=REEMPLAZAR
FTP_USER=REEMPLAZAR
FTP_PASS=REEMPLAZAR

# --- Redes (Postiz) ---
POSTIZ_URL=https://TU-POSTIZ/api
POSTIZ_API_KEY=REEMPLAZAR
PUBLICAR_KEY=REEMPLAZAR            # clave del webhook n8n de publicación nativa (respaldo IG/FB)

# --- Analítica (Umami) ---
UMAMI_URL=https://TU-UMAMI
UMAMI_USER=admin
UMAMI_PASS=REEMPLAZAR
UMAMI_WEBSITE_ID=REEMPLAZAR

# --- Datos externos / enriquecimiento ---
YOUTUBE_API_KEY=REEMPLAZAR
SERPER_API_KEY=REEMPLAZAR
APIFY_TOKEN=REEMPLAZAR

# --- Notificaciones push (VAPID) ---
VAPID_PUBLIC_KEY=REEMPLAZAR
VAPID_PRIVATE_KEY=REEMPLAZAR

# --- Correo ---
BCC_OUTREACH=copia@tudominio.com   # BCC opcional para archivar el outreach

# Secretos de API que se guardan en el VAULT de Accesos (NO aquí), vía la interfaz:
# PEXELS_KEY, UNSPLASH_KEY, PIXABAY_KEY, COVERR_KEY, FAL_API_KEY,
# FB_CAPI_TOKEN, FB_PIXEL_ID, FB_CAPI_TEST, ATP_TOKEN, DATAFORSEO_LOGIN/PASSWORD, GOOGLE_ADS_TOKEN
