      "parameters": {
        "jsCode": "// Normaliza el evento de compra de Hotmart / ClickBank / ThriveCart.\n// AJUSTA las rutas de campos a tu cuenta si tu payload difiere.\nconst b = $json.body || $json;\nlet email, nombre, evento, plataforma;\n\nif (b.data && b.data.buyer) {                 // Hotmart\n  plataforma = 'hotmart';\n  email  = b.data.buyer.email;\n  nombre = b.data.buyer.name;\n  evento = b.event;\n} else if (b.transactionType || b.receipt) {  // ClickBank\n  plataforma = 'clickbank';\n  email  = (b.customer && b.customer.billing && b.customer.billing.email) || b.email;\n  nombre = (b.customer && b.customer.billing && b.customer.billing.fullName) || b.name;\n  evento = b.transactionType;\n} else {                                       // ThriveCart u otro\n  plataforma = b.plataforma || 'thrivecart';\n  email  = b.customer_email || b.email;\n  nombre = b.customer_name  || b.name || '';\n  evento = b.event || b.order_status;\n}\n\nconst compra    = /approved|sale|success|complete|paid/i.test(evento || '');\nconst reembolso = /refund|refunded|chargeback|cgbk|rfnd|cancel|dispute/i.test(evento || '');\nconst lang = String(b.lang || b.locale || 'es').toLowerCase().startsWith('en') ? 'en' : 'es';\n\n// Contraseña segura (crypto). Requiere NODE_FUNCTION_ALLOW_BUILTIN=crypto en n8n;\n// si no está, cae a un fallback para no romper el alta.\nfunction genPass() {\n  try {\n    const crypto = require('crypto');\n    const AL = 'ABCDEFGHJKMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';\n    const SIM = '!@#$%*?';\n    const pick = (set, n) => Array.from(crypto.randomBytes(n)).map(x => set[x % set.length]).join('');\n    const bruto = pick(AL, 12) + pick(SIM, 1);\n    return bruto.split('').map(c => ({ c, o: crypto.randomInt(1e6) }))\n                .sort((a, b) => a.o - b.o).map(x => x.c).join('');\n  } catch (e) {\n    const abc = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';\n    let s = ''; for (let i = 0; i < 12; i++) s += abc[Math.floor(Math.random() * abc.length)];\n    return s + '!7';\n  }\n}\n\nreturn [{ json: {\n  email: (email || '').trim().toLowerCase(),\n  nombre: nombre || '',\n  plataforma,\n  lang,\n  password: genPass(),\n  accion: compra ? 'compra' : (reembolso ? 'reembolso' : 'ignorar')\n}}];"
      },
