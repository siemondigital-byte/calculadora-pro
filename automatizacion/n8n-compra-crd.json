    {
      "parameters": {
        "jsCode": "const T = { es: \"<!doctype html>\\n<html lang=\\\"es\\\" xmlns=\\\"http://www.w3.org/1999/xhtml\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\" />\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n<meta name=\\\"x-apple-disable-message-reformatting\\\" />\\n<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\" />\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\" />\\n<title>Restablece tu contraseña · The Money Command</title>\\n<!--\\n  ============================================================================\\n  THE MONEY COMMAND · Correo de cambio de contraseña — versión para n8n (ES)\\n  ----------------------------------------------------------------------------\\n  Compatible con clientes de correo (tablas + estilos inline). Modo oscuro\\n  automático vía prefers-color-scheme.\\n\\n  VARIABLES a rellenar en el nodo de n8n (Set / Edit Fields o el propio Send Email):\\n    {{NOMBRE}}      -> nombre del usuario\\n    {{EMAIL}}       -> correo de la cuenta\\n    {{PASSWORD}}    -> contrasena generada\\n    {{APP_URL}}     -> URL de la app (boton)\\n    {{APP_NAME}}    -> nombre visible del producto\\n    {{ACCENT}}      -> color de acento (hex)\\n    {{URL_SOPORTE}} -> enlace de soporte\\n  Elige el archivo -ES o -EN según el idioma del usuario en tu workflow.\\n  ============================================================================\\n-->\\n<style>\\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\\n  body,table,td,a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\\n  table,td { mso-table-lspace:0pt; mso-table-rspace:0pt; }\\n  img { border:0; line-height:100%; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }\\n  a { text-decoration:none; }\\n  @media (prefers-color-scheme: dark) {\\n    .bg      { background:#0a0a0f !important; }\\n    .card    { background:#14141d !important; border-color:#262630 !important; }\\n    .divider { border-color:#262630 !important; }\\n    .soft    { background:#1c1c27 !important; border-color:#262630 !important; }\\n    .t-strong{ color:#f0f0f8 !important; }\\n    .t-body  { color:#b9b9c8 !important; }\\n    .t-mut   { color:#8a8a9e !important; }\\n    .t-faint { color:#6a6a7c !important; }\\n    .pre     { background:#1c1c27 !important; color:#6a6a7c !important; }\\n  }\\n  @media (max-width:600px){\\n    .px { padding-left:22px !important; padding-right:22px !important; }\\n    .container { width:100% !important; }\\n  }\\n</style>\\n</head>\\n<body class=\\\"bg\\\" style=\\\"margin:0;padding:0;background:#eef0f3;\\\">\\n  <div style=\\\"display:none;max-height:0;overflow:hidden;opacity:0;\\\">Crea una nueva contraseña para tu cuenta. El enlace vence en 60 minutos.</div>\\n  <table role=\\\"presentation\\\" class=\\\"bg\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#eef0f3;\\\">\\n    <tr><td align=\\\"center\\\" style=\\\"padding:30px 14px 60px;\\\">\\n      <table role=\\\"presentation\\\" class=\\\"container\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:600px;max-width:600px;\\\">\\n\\n        <!-- card -->\\n        <tr><td class=\\\"card\\\" style=\\\"background:#ffffff;border:1px solid #e4e6ea;border-radius:16px;\\\">\\n\\n          <!-- header -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\">\\n            <tr><td class=\\\"divider px\\\" style=\\\"padding:24px 34px 20px;border-bottom:1px solid #e4e6ea;\\\">\\n              <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n                <td width=\\\"12\\\" valign=\\\"middle\\\" style=\\\"width:12px;padding:0;\\\"><div style=\\\"width:11px;height:11px;min-width:11px;border-radius:50%;background:{{ACCENT}};font-size:0;line-height:0;\\\">&nbsp;</div></td>\\n                <td valign=\\\"middle\\\" class=\\\"t-strong\\\" style=\\\"padding-left:11px;font-family:'Syne',Arial,sans-serif;font-weight:800;font-size:17px;letter-spacing:-.3px;color:#15151f;white-space:nowrap;\\\">The Money <span style=\\\"color:{{ACCENT}};\\\">Command</span></td>\\n              </tr></table>\\n            </td></tr>\\n          </table>\\n\\n          <!-- body -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:30px 34px 6px;\\\">\\n            <p style=\\\"margin:0 0 12px;font-family:'DM Mono',Menlo,monospace;font-size:10px;letter-spacing:2.2px;text-transform:uppercase;color:{{ACCENT}};\\\">Tu acceso está listo</p>\\n            <h1 class=\\\"t-strong\\\" style=\\\"margin:0 0 14px;font-family:'Syne',Arial,sans-serif;font-weight:800;font-size:29px;line-height:1.14;letter-spacing:-.5px;color:#15151f;\\\">Bienvenido/a a <span style=\\\"color:{{ACCENT}};\\\">tu cuenta.</span></h1>\\n            <p class=\\\"t-body\\\" style=\\\"margin:0 0 4px;font-family:'DM Mono',Menlo,monospace;font-size:14px;line-height:1.65;color:#55556a;\\\">Hola {{NOMBRE}}, creamos tu cuenta. Abajo están tus datos de acceso. Te recomendamos cambiar la contraseña la primera vez que entres.</p>\\n          </td></tr></table>\\n\\n          <!-- app chip -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:11px;\\\"><tr>\\n              <td style=\\\"padding:9px 14px 9px 11px;font-family:'DM Mono',Menlo,monospace;\\\">\\n                <span class=\\\"t-faint\\\" style=\\\"font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:#8a8a99;\\\">Cuenta creada en</span><br>\\n                <span class=\\\"t-strong\\\" style=\\\"font-family:'Syne',Arial,sans-serif;font-weight:700;font-size:13.5px;color:#15151f;\\\">{{APP_NAME}}</span>\\n              </td>\\n            </tr></table>\\n          </td></tr></table>\\n\\n          <!-- CTA -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" align=\\\"left\\\" style=\\\"padding:24px 34px 4px;\\\">\\n            <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n              <td style=\\\"border-radius:13px;background:{{ACCENT}};\\\">\\n                <a href=\\\"{{APP_URL}}\\\" target=\\\"_blank\\\" style=\\\"display:inline-block;padding:16px 30px;font-family:'Syne',Arial,sans-serif;font-weight:700;font-size:15px;letter-spacing:-.2px;color:#ffffff;border-radius:13px;\\\">Entrar a la app &rarr;</a>\\n              </td>\\n            </tr></table>\\n          </td></tr></table>\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:12px 34px 0;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:11px;letter-spacing:.4px;color:#8a8a99;\\\">◷ Guarda estos datos en un lugar seguro.</p>\\n          </td></tr></table>\\n\\n          <!-- fallback -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:22px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <div class=\\\"t-faint\\\" style=\\\"font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;color:#8a8a99;margin-bottom:6px;\\\">Tus datos de acceso</div>\\n              <a href=\\\"{{APP_URL}}\\\" style=\\\"color:#1499c9;font-size:11.5px;word-break:break-all;\\\">{{RESET_LINK}}</a>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- security -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <p class=\\\"t-mut\\\" style=\\\"margin:0;font-size:12px;line-height:1.55;color:#5d5d6c;\\\"><b style=\\\"color:inherit;\\\">Importante.</b> Nunca compartas esta contraseña. Cámbiala al entrar por primera vez desde tu perfil.<b style=\\\"display:none\\\"></p>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- signature -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 6px;\\\">\\n            <p class=\\\"t-mut\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:12.5px;color:#5d5d6c;\\\">Cualquier duda, responde a este correo. Nos vemos dentro.<br><b style=\\\"font-family:'Syne',Arial,sans-serif;\\\">El equipo de The Money Command</b></p>\\n          </td></tr></table>\\n\\n          <!-- footer -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"divider px\\\" style=\\\"padding:20px 34px 28px;border-top:1px solid #e4e6ea;margin-top:16px;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:16px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;line-height:1.6;color:#8a8a99;\\\">Recibes este correo porque se creó una cuenta para ti.</p>\\n            <p class=\\\"t-faint\\\" style=\\\"margin:8px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;color:#8a8a99;\\\">© 2026 The Money Command · <a href=\\\"{{URL_SOPORTE}}\\\" class=\\\"t-mut\\\" style=\\\"color:#5d5d6c;\\\">Soporte</a></p>\\n          </td></tr></table>\\n\\n        </td></tr>\\n      </table>\\n    </td></tr>\\n  </table>\\n</body>\\n</html>\", en: \"<!doctype html>\\n<html lang=\\\"en\\\" xmlns=\\\"http://www.w3.org/1999/xhtml\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\" />\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\" />\\n<meta name=\\\"x-apple-disable-message-reformatting\\\" />\\n<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\" />\\n<meta name=\\\"supported-color-schemes\\\" content=\\\"light dark\\\" />\\n<title>Reset your password · The Money Command</title>\\n<!--\\n  ============================================================================\\n  THE MONEY COMMAND · Correo de cambio de contraseña — versión para n8n (EN)\\n  ----------------------------------------------------------------------------\\n  Compatible con clientes de correo (tablas + estilos inline). Modo oscuro\\n  automático vía prefers-color-scheme.\\n\\n  VARIABLES a rellenar en el nodo de n8n (Set / Edit Fields o el propio Send Email):\\n    {{NOMBRE}}      -> nombre del usuario\\n    {{EMAIL}}       -> correo de la cuenta\\n    {{PASSWORD}}    -> contrasena generada\\n    {{APP_URL}}     -> URL de la app (boton)\\n    {{APP_NAME}}    -> nombre visible del producto\\n    {{ACCENT}}      -> color de acento (hex)\\n    {{URL_SOPORTE}} -> enlace de soporte\\n  Elige el archivo -ES o -EN según el idioma del usuario en tu workflow.\\n  ============================================================================\\n-->\\n<style>\\n  :root { color-scheme: light dark; supported-color-schemes: light dark; }\\n  body,table,td,a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }\\n  table,td { mso-table-lspace:0pt; mso-table-rspace:0pt; }\\n  img { border:0; line-height:100%; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }\\n  a { text-decoration:none; }\\n  @media (prefers-color-scheme: dark) {\\n    .bg      { background:#0a0a0f !important; }\\n    .card    { background:#14141d !important; border-color:#262630 !important; }\\n    .divider { border-color:#262630 !important; }\\n    .soft    { background:#1c1c27 !important; border-color:#262630 !important; }\\n    .t-strong{ color:#f0f0f8 !important; }\\n    .t-body  { color:#b9b9c8 !important; }\\n    .t-mut   { color:#8a8a9e !important; }\\n    .t-faint { color:#6a6a7c !important; }\\n    .pre     { background:#1c1c27 !important; color:#6a6a7c !important; }\\n  }\\n  @media (max-width:600px){\\n    .px { padding-left:22px !important; padding-right:22px !important; }\\n    .container { width:100% !important; }\\n  }\\n</style>\\n</head>\\n<body class=\\\"bg\\\" style=\\\"margin:0;padding:0;background:#eef0f3;\\\">\\n  <div style=\\\"display:none;max-height:0;overflow:hidden;opacity:0;\\\">Create a new password for your account. The link expires in 60 minutes.</div>\\n  <table role=\\\"presentation\\\" class=\\\"bg\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"background:#eef0f3;\\\">\\n    <tr><td align=\\\"center\\\" style=\\\"padding:30px 14px 60px;\\\">\\n      <table role=\\\"presentation\\\" class=\\\"container\\\" width=\\\"600\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" style=\\\"width:600px;max-width:600px;\\\">\\n\\n        <!-- card -->\\n        <tr><td class=\\\"card\\\" style=\\\"background:#ffffff;border:1px solid #e4e6ea;border-radius:16px;\\\">\\n\\n          <!-- header -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\">\\n            <tr><td class=\\\"divider px\\\" style=\\\"padding:24px 34px 20px;border-bottom:1px solid #e4e6ea;\\\">\\n              <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n                <td width=\\\"12\\\" valign=\\\"middle\\\" style=\\\"width:12px;padding:0;\\\"><div style=\\\"width:11px;height:11px;min-width:11px;border-radius:50%;background:{{ACCENT}};font-size:0;line-height:0;\\\">&nbsp;</div></td>\\n                <td valign=\\\"middle\\\" class=\\\"t-strong\\\" style=\\\"padding-left:11px;font-family:'Syne',Arial,sans-serif;font-weight:800;font-size:17px;letter-spacing:-.3px;color:#15151f;white-space:nowrap;\\\">The Money <span style=\\\"color:{{ACCENT}};\\\">Command</span></td>\\n              </tr></table>\\n            </td></tr>\\n          </table>\\n\\n          <!-- body -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:30px 34px 6px;\\\">\\n            <p style=\\\"margin:0 0 12px;font-family:'DM Mono',Menlo,monospace;font-size:10px;letter-spacing:2.2px;text-transform:uppercase;color:{{ACCENT}};\\\">Your access is ready</p>\\n            <h1 class=\\\"t-strong\\\" style=\\\"margin:0 0 14px;font-family:'Syne',Arial,sans-serif;font-weight:800;font-size:29px;line-height:1.14;letter-spacing:-.5px;color:#15151f;\\\">Welcome to <span style=\\\"color:{{ACCENT}};\\\">your account.</span></h1>\\n            <p class=\\\"t-body\\\" style=\\\"margin:0 0 4px;font-family:'DM Mono',Menlo,monospace;font-size:14px;line-height:1.65;color:#55556a;\\\">Hi {{NOMBRE}}, we created your account. Your sign-in details are below. We recommend changing your password the first time you sign in.</p>\\n          </td></tr></table>\\n\\n          <!-- app chip -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:11px;\\\"><tr>\\n              <td style=\\\"padding:9px 14px 9px 11px;font-family:'DM Mono',Menlo,monospace;\\\">\\n                <span class=\\\"t-faint\\\" style=\\\"font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:#8a8a99;\\\">Account created in</span><br>\\n                <span class=\\\"t-strong\\\" style=\\\"font-family:'Syne',Arial,sans-serif;font-weight:700;font-size:13.5px;color:#15151f;\\\">{{APP_NAME}}</span>\\n              </td>\\n            </tr></table>\\n          </td></tr></table>\\n\\n          <!-- CTA -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" align=\\\"left\\\" style=\\\"padding:24px 34px 4px;\\\">\\n            <table role=\\\"presentation\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr>\\n              <td style=\\\"border-radius:13px;background:{{ACCENT}};\\\">\\n                <a href=\\\"{{APP_URL}}\\\" target=\\\"_blank\\\" style=\\\"display:inline-block;padding:16px 30px;font-family:'Syne',Arial,sans-serif;font-weight:700;font-size:15px;letter-spacing:-.2px;color:#ffffff;border-radius:13px;\\\">Go to the app &rarr;</a>\\n              </td>\\n            </tr></table>\\n          </td></tr></table>\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:12px 34px 0;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:11px;letter-spacing:.4px;color:#8a8a99;\\\">◷ Keep these details somewhere safe.</p>\\n          </td></tr></table>\\n\\n          <!-- fallback -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:22px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <div class=\\\"t-faint\\\" style=\\\"font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;color:#8a8a99;margin-bottom:6px;\\\">Your sign-in details</div>\\n              <a href=\\\"{{APP_URL}}\\\" style=\\\"color:#1499c9;font-size:11.5px;word-break:break-all;\\\">{{RESET_LINK}}</a>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- security -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 0;\\\">\\n            <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\" class=\\\"soft\\\" style=\\\"background:#f4f6f8;border:1px solid #e4e6ea;border-radius:12px;\\\"><tr><td style=\\\"padding:14px 16px;font-family:'DM Mono',Menlo,monospace;\\\">\\n              <p class=\\\"t-mut\\\" style=\\\"margin:0;font-size:12px;line-height:1.55;color:#5d5d6c;\\\"><b style=\\\"color:inherit;\\\">Important.</b> Never share this password. Change it from your profile the first time you sign in.<b style=\\\"display:none\\\"></p>\\n            </td></tr></table>\\n          </td></tr></table>\\n\\n          <!-- signature -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"px\\\" style=\\\"padding:20px 34px 6px;\\\">\\n            <p class=\\\"t-mut\\\" style=\\\"margin:0;font-family:'DM Mono',Menlo,monospace;font-size:12.5px;color:#5d5d6c;\\\">Any questions, just reply to this email. See you inside.<br><b style=\\\"font-family:'Syne',Arial,sans-serif;\\\">The Money Command team</b></p>\\n          </td></tr></table>\\n\\n          <!-- footer -->\\n          <table role=\\\"presentation\\\" width=\\\"100%\\\" cellpadding=\\\"0\\\" cellspacing=\\\"0\\\"><tr><td class=\\\"divider px\\\" style=\\\"padding:20px 34px 28px;border-top:1px solid #e4e6ea;margin-top:16px;\\\">\\n            <p class=\\\"t-faint\\\" style=\\\"margin:16px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;line-height:1.6;color:#8a8a99;\\\">You received this email because an account was created for you.</p>\\n            <p class=\\\"t-faint\\\" style=\\\"margin:8px 0 0;font-family:'DM Mono',Menlo,monospace;font-size:11px;color:#8a8a99;\\\">© 2026 The Money Command · <a href=\\\"{{URL_SOPORTE}}\\\" class=\\\"t-mut\\\" style=\\\"color:#5d5d6c;\\\">Support</a></p>\\n          </td></tr></table>\\n\\n        </td></tr>\\n      </table>\\n    </td></tr>\\n  </table>\\n</body>\\n</html>\" };\n\nconst j = $json;\nconst lang = j.lang === 'en' ? 'en' : 'es';\nconst APP_URL = \"https://siemondigital-byte.github.io/calculadora-pro\";\nconst APP_NAME = lang === 'en'\n  ? 'Real Estate Viability Pro Calculator'\n  : 'Calculadora de Viabilidad Inmobiliaria Pro';\nlet html = T[lang]\n  .split('{{NOMBRE}}').join(j.nombre || '')\n  .split('{{EMAIL}}').join(j.email || '')\n  .split('{{PASSWORD}}').join(j.password || '')\n  .split('{{APP_URL}}').join(APP_URL)\n  .split('{{RESET_LINK}}').join(APP_URL)\n  .split('{{APP_NAME}}').join(APP_NAME)\n  .split('{{ACCENT}}').join('#E6C788')\n  .split('{{URL_SOPORTE}}').join(\"mailto:soporte@atlantisglobalrealty.com\");\nconst subject = lang === 'en' ? ('Your access · ' + APP_NAME) : ('Tu acceso · ' + APP_NAME);\nreturn [{ json: { html, subject, to: j.email } }];"
