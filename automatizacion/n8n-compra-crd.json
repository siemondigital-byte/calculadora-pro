{
  "name": "Ciclo de Riqueza · Compra → Supabase",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "compra-crd",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "n_webhook",
      "name": "Webhook Compra",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -40,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normaliza el evento de compra de Hotmart / ClickBank / ThriveCart.\n// AJUSTA las rutas de campos a tu cuenta si tu payload difiere.\nconst b = $json.body || $json;\nlet email, nombre, evento, plataforma;\n\nif (b.data && b.data.buyer) {                 // Hotmart\n  plataforma = 'hotmart';\n  email  = b.data.buyer.email;\n  nombre = b.data.buyer.name;\n  evento = b.event;                            // PURCHASE_APPROVED / PURCHASE_REFUNDED / PURCHASE_CHARGEBACK\n} else if (b.transactionType || b.receipt) {  // ClickBank\n  plataforma = 'clickbank';\n  email  = (b.customer && b.customer.billing && b.customer.billing.email) || b.email;\n  nombre = (b.customer && b.customer.billing && b.customer.billing.fullName) || b.name;\n  evento = b.transactionType;                  // SALE / RFND / CGBK\n} else {                                       // ThriveCart u otro\n  plataforma = b.plataforma || 'thrivecart';\n  email  = b.customer_email || b.email;\n  nombre = b.customer_name  || b.name || '';\n  evento = b.event || b.order_status;          // success / refund ...\n}\n\nconst compra    = /approved|sale|success|complete|paid/i.test(evento || '');\nconst reembolso = /refund|refunded|chargeback|cgbk|rfnd|cancel|dispute/i.test(evento || '');\n\nfunction genPass(n = 12) {\n  const abc = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';\n  let s = ''; for (let i = 0; i < n; i++) s += abc[Math.floor(Math.random() * abc.length)];\n  return s;\n}\n\nreturn [{ json: {\n  email: (email || '').trim().toLowerCase(),\n  nombre: nombre || '',\n  plataforma,\n  password: genPass(12),\n  accion: compra ? 'compra' : (reembolso ? 'reembolso' : 'ignorar')\n}}];\n"
      },
      "id": "n_norm",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "c-compra",
                    "leftValue": "={{ $json.accion }}",
                    "rightValue": "compra",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "compra"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "c-reembolso",
                    "leftValue": "={{ $json.accion }}",
                    "rightValue": "reembolso",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reembolso"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "ignorar"
        }
      },
      "id": "n_switch",
      "name": "¿Acción?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        440,
        300
      ]
    },
