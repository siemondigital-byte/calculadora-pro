      "parameters": {
        "operation": "executeQuery",
        "query": "WITH t AS ( SELECT email, app, lang FROM password_resets WHERE token=$1 AND usado=false AND expira_en > now() LIMIT 1 ), u AS ( UPDATE password_resets SET usado=true WHERE token=$1 AND usado=false AND expira_en > now() RETURNING email ) SELECT (SELECT email FROM t) AS email, (SELECT app FROM t) AS app, (SELECT lang FROM t) AS lang;",
        "options": {
          "queryReplacement": "={{ [ $json.body.token || '' ] }}"
        }
